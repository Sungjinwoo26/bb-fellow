{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "find-my-routine-e2e",
  "main": "../worker/index.ts",
  "compatibility_date": "2026-11-03",
  "assets": { "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api", "/api/*"] },
  "ratelimits": [
    { "name": "PHOTO_CLIENT_LIMIT", "namespace_id": "73420301", "simple": { "limit": 12, "period": 60 } },
    { "name": "PHOTO_LOCATION_LIMIT", "namespace_id": "73420302", "simple": { "limit": 60, "period": 60 } }
  ]
}
